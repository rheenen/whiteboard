{
  "name": "@dev.fast/trace-core",
  "version": "0.0.0",
  "private": true,
  "description": "General utilities and the cleanup of earlier trace hooks for the Whiteboard CLI.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:workspace-deps": "pnpm --filter @dev.fast/json --filter @dev.fast/local-vcs build",
    "prebuild": "pnpm run build:workspace-deps",
    "build": "tsdown",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "pnpm -w exec tsc --noEmit -p packages/trace-core"
  },
  "dependencies": {
    "@dev.fast/json": "workspace:*",
    "@dev.fast/local-vcs": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "tsdown": "0.22.14",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
